# Container registry hostname/prefix. Use your mirror hostname if needed.
REGISTRY_PREFIX=docker.io

# Host paths. Relative paths are resolved from this repository directory.
MUSIC_ROOT=./music
NAVIDROME_DATA=./data/navidrome

# Host identity used by Navidrome and the cleaner container.
PUID=1000
PGID=1000
TZ=Europe/Moscow

# Navidrome listens on this host address and port. Keep localhost unless you
# deliberately configure a reverse proxy or another trusted network path.
NAVIDROME_BIND_ADDRESS=127.0.0.1
NAVIDROME_PORT=4533
ND_SCANSCHEDULE=1h

# Cleaner policy. Size is measured in GiB (1024^3 bytes).
CACHE_MAX_AGE_DAYS=30
CACHE_MAX_SIZE_GB=20
CACHE_MIN_AGE_MINUTES=60
CLEANER_INTERVAL_SECONDS=3600
DRY_RUN=true

# Optional Navidrome account for Subsonic startScan after real deletions.
# Keep these values only in your ignored local .env file.
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_TIMEOUT_SECONDS=8

# Cleaner single-instance lock file inside its container.
LOCK_FILE=/tmp/cleaner.lock
